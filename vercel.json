{
  "version": 2,
  "functions": {
    "server/server.js": { "runtime": "@vercel/node" },
    "llm_service/main.py": { "runtime": "@vercel/python" }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/api/query",
      "destination": "/llm_service/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
